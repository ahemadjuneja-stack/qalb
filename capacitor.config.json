{
  "appId": "com.qalb.app",
  "appName": "Qalb",
  "webDir": "out",
  "backgroundColor": "#060B09",
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#060B09"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#060B09",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#060B09"
    },
    "MediaSession": {
      "enabled": true
    }
  },
  "server": {
    "androidScheme": "https"
  }
}
