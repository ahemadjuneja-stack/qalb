# Qalb — environment variables (copy → .env aur values bharo)
# ─────────────────────────────────────────────────────────────────
# v0.5.34 se search SIRF official YouTube Data API v3 se hota hai.
# Key banao (FREE, 2 minute):
#   1. https://console.cloud.google.com → naya project (ya purana)
#   2. APIs & Services → Library → "YouTube Data API v3" → ENABLE
#   3. APIs & Services → Credentials → Create Credentials → API key
# Free quota: 10,000 units/day (search = 100 units, lists = 1 unit).
# Doston wali private app ke liye kaafi. Key leak ho to console se
# regenerate + RESTRICT kar lena (YouTube Data API only).

# Hosted website/server runtime (web deploy par ye use hota hai)
YOUTUBE_API_KEY=

# APK build (client bundle me bake hota hai — NEXT_PUBLIC zaroori hai
# warna APK ke andar search kaam nahi karegi)
NEXT_PUBLIC_YOUTUBE_API_KEY=

# Hosted API base (web dev ke liye — APK me khali rehta hai)
NEXT_PUBLIC_API_BASE=
