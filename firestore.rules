rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  Qalb — Firestore Security Rules
//
//  Design:
//    • Firestore me sirf TEXT/records (playlists, tracks, products,
//      version info) — audio/images/video KABHI nahi (unki jagah
//      file storage, Firestore me sirf unka URL).
//    • ci_private collection = CI keystore + secrets — dono taraf
//      se BLOCKED (sirf Admin SDK / service account access kar sakta hai).
//    • Writes public ke liye band — content sirf Firebase console /
//      service account se update hoga.
//
//  Publish kaise karein:
//    Firebase console → Firestore Database → Rules → ye paste → Publish
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── PUBLIC READ (app in-data direct REST se uthati hai) ──
    match /appVersions/{doc} { allow read: if true;  allow write: if false; }
    match /playlists/{doc}   { allow read: if true;  allow write: if false; }
    match /tracks/{doc}      { allow read: if true;  allow write: if false; }
    match /products/{doc}    { allow read: if true;  allow write: if false; }

    // ── SAFETY NET (v0.2.1-25) ──
    // crashLogs: app crash reports yahan likhti hai (sirf create + read —
    // koi update/delete nahi, tamper-proof log).
    match /crashLogs/{doc}   { allow read: if true;  allow create: if true;
                               allow update, delete: if false; }
    // remoteConfig: kill switch / force-update / feature flags (read-only).
    // Doc `remoteConfig/app` Firebase console se manually banaya/edit hota hai.
    match /remoteConfig/{doc} { allow read: if true;  allow write: if false; }

    // ── ISLAMIC REELS (v0.2.5) ──
    // reels: curated/pinned reels (videoId, title, category, order, active)
    //        — console/service-account se manage, public read-only.
    match /reels/{doc}      { allow read: if true;  allow write: if false; }
    // reelConfig/blocked: block-list (array `ids`) — public read-only.
    match /reelConfig/{doc} { allow read: if true;  allow write: if false; }
    // reelMeta/likes: global like counts (map videoId → int). Increment
    // transform se update hota hai — v1 me open write (sirf counts data).
    match /reelMeta/{doc}   { allow read: if true;  allow write: if true; }

    // ── PRIVATE: CI keystore + secrets — CLIENT KE LIYE POORA BAND ──
    // (keystore base64 yahin rehti hai — bahar kabhi nahi jayegi)
    match /ci_private/{doc}  { allow read: if false; allow write: if false; }

    // ── logged-in users ka apna data (future ke liye) ──
    match /users/{uid}       { allow read, write: if request.auth != null; }

    // ── DEVICE SESSION (v0.5.26) — uninstall-proof login restore ──
    // Doc id = sha256(ANDROID_ID+salt); value me AES-256-GCM encrypted
    // refresh-token. `get` allowed (device khud apna id jaanta hai),
    // `list` BAND — koi enumeration possible nahi. Field-validate.
    match /deviceSessions/{doc} {
      allow get: if true;
      allow list: if false;
      allow create, update: if true
        && request.resource.data.keys().hasOnly(
             ['v','uid','name','email','phone','photoUrl','provider','d','at'])
        && request.resource.data.v == 1
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.d is string
        && request.resource.data.d.size() > 0
        && request.resource.data.d.size() < 3000;
      allow delete: if true;
    }

    // ── baaki sab kuch default CLOSED ──
    match /{document=**}     { allow read, write: if false; }
  }
}
