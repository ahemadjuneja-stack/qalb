<?xml version="1.0" encoding="utf-8"?>
<!--
  Qalb — Compact media control bar (v0.5.17)
  • EK HI ROW — left me Previous, beech me Play/Pause (emerald circle),
    right me Next + sabse right me chhota close (×)
  • Koi thumbnail NAHI (user request)
  • Single row = Android 12+ height-cap me bhi HAMESHA poora dikhega
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#EEF3E8"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- Center: prev | play/pause | next -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_notif_prev"
            android:tint="#1C2F24"
            android:contentDescription="Pichla kalam" />

        <ImageView
            android:id="@+id/notif_toggle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="12dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:src="@drawable/ic_notif_play"
            android:tint="#FFFFFF"
            android:background="@drawable/notif_toggle_bg"
            android:contentDescription="Play / Pause" />

        <ImageView
            android:id="@+id/notif_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_notif_next"
            android:tint="#1C2F24"
            android:contentDescription="Agla kalam" />
    </LinearLayout>

    <!-- Right corner: close (×) -->
    <ImageView
        android:id="@+id/notif_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:padding="7dp"
        android:src="@drawable/ic_notif_close"
        android:tint="#5A6E61"
        android:contentDescription="Band karein" />
</FrameLayout>
