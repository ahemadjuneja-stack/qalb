<?xml version="1.0" encoding="utf-8"?>
<!--
  Qalb — Custom media notification (v0.2.2)
  • Light sage theme app jaisa: ivory bg + deep emerald ink + green accent
  • Heartbeat seek: ViewFlipper 3 frames (upar-niche-upar-niche) auto-cycle
  • Close (×) button hamesha visible — tap = song stop + notification band
  NOTE: RemoteViews me sirf limited views allowed — LinearLayout/FrameLayout/
  TextView/ImageView/ViewFlipper sab allowed hain.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EEF3E8"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- Row 1: thumbnail + title/artist + close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/notif_thumb"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#1C2F24"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#5A6E61"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/notif_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_notif_close"
            android:tint="#5A6E61"
            android:contentDescription="Band karein" />
    </LinearLayout>

    <!-- Row 2: heartbeat seek line -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp">

        <!-- paused: static line -->
        <ImageView
            android:id="@+id/notif_seek_static"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!-- playing: 3-frame heartbeat bounce (auto-cycle, koi re-notify nahi) -->
        <ViewFlipper
            android:id="@+id/notif_flip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="140"
            android:inAnimation="@null"
            android:outAnimation="@null">

            <ImageView
                android:id="@+id/notif_seek_a"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/notif_seek_b"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/notif_seek_c"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null" />
        </ViewFlipper>
    </FrameLayout>

    <!-- Row 3: time labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/notif_pos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#5A6E61"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/notif_dur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5A6E61"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Row 4: prev | play/pause | next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/notif_prev"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="11dp"
            android:src="@drawable/ic_notif_prev"
            android:tint="#1C2F24"
            android:contentDescription="Pichla kalam" />

        <ImageView
            android:id="@+id/notif_toggle"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:padding="13dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_notif_play"
            android:tint="#FFFFFF"
            android:background="@drawable/notif_toggle_bg"
            android:contentDescription="Play / Pause" />

        <ImageView
            android:id="@+id/notif_next"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:padding="11dp"
            android:src="@drawable/ic_notif_next"
            android:tint="#1C2F24"
            android:contentDescription="Agla kalam" />
    </LinearLayout>
</LinearLayout>
