<?xml version="1.0" encoding="utf-8"?>
<!--
  Qalb — Expanded media notification (v0.5.17)
  • Buttons row SABSE UPAR (agar koi OEM height-cap lagaye to text katega,
    buttons kabhi nahi — v0.2.2 wala bug yahin se fix)
  • Neeche title + artist (koi thumbnail NAHI — user request)
  • Light sage theme: ivory bg + deep emerald ink + emerald accent circle
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EEF3E8"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <!-- Row 1: prev | play/pause | next (center) + close (right) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/notif_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_notif_prev"
                android:tint="#1C2F24"
                android:contentDescription="Pichla kalam" />

            <ImageView
                android:id="@+id/notif_toggle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="12dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:src="@drawable/ic_notif_play"
                android:tint="#FFFFFF"
                android:background="@drawable/notif_toggle_bg"
                android:contentDescription="Play / Pause" />

            <ImageView
                android:id="@+id/notif_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_notif_next"
                android:tint="#1C2F24"
                android:contentDescription="Agla kalam" />
        </LinearLayout>

        <ImageView
            android:id="@+id/notif_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:padding="7dp"
            android:src="@drawable/ic_notif_close"
            android:tint="#5A6E61"
            android:contentDescription="Band karein" />
    </FrameLayout>

    <!-- Row 2: title -->
    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#1C2F24"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Row 3: artist -->
    <TextView
        android:id="@+id/notif_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#5A6E61"
        android:textSize="11sp" />
</LinearLayout>
