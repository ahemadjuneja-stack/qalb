<?xml version="1.0" encoding="utf-8"?>
<!--
  Qalb — Expanded media notification (v0.5.19)
  • UPAR bada button cluster: [prev | play/pause circle | next] — paas-paas,
    close (×) usi row ke right corner me (v0.5.31: bada circle-button)
  • Neeche title + artist (thumbnail NAHI — user request)
  • Buttons row SABSE UPAR — kabhi cut hui to bhi buttons safe
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#EEF3E8"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="14dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- Buttons row: cluster center me, close right corner me -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/notif_prev"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="9dp"
                android:src="@drawable/ic_notif_prev"
                android:tint="#1C2F24"
                android:contentDescription="Pichla kalam" />

            <ImageView
                android:id="@+id/notif_toggle"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="14dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_notif_play"
                android:tint="#FFFFFF"
                android:background="@drawable/notif_toggle_bg"
                android:contentDescription="Play / Pause" />

            <ImageView
                android:id="@+id/notif_next"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="9dp"
                android:src="@drawable/ic_notif_next"
                android:tint="#1C2F24"
                android:contentDescription="Agla kalam" />
        </LinearLayout>

        <ImageView
            android:id="@+id/notif_close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="end|center_vertical"
            android:padding="10dp"
            android:src="@drawable/ic_notif_close"
            android:tint="#1C2F24"
            android:background="@drawable/notif_close_bg"
            android:contentDescription="Band karein" />
    </FrameLayout>

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1C2F24" />

    <TextView
        android:id="@+id/notif_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11.5sp"
        android:textColor="#5A6E61" />
</LinearLayout>
